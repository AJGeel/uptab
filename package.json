{
  "name": "uptab",
  "displayName": "UpTab",
  "version": "1.5.1",
  "description": "What's UpTab?",
  "author": "Arthur Geel <ageel@enrise.com>",
  "scripts": {
    "dev": "BUILD_TARGET=firefox nodemon & bun load:firefox",
    "build": "BUILD_TARGET=chrome vite build && BUILD_TARGET=firefox vite build",
    "zip": "cd dist/firefox && zip -r firefox.zip . && mv firefox.zip ../firefox.zip && cd ../../ && cd dist/chromium && zip -r chromium.zip . && mv chromium.zip ../chromium.zip && cd ../../",
    "ship": "bun run build && bun zip",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --output json --pretty | grep -v 'Applying config file: ./package.json' > dist/firefox-lint-output.json",
    "load:firefox": "web-ext run --source-dir dist/firefox",
    "store:auth": "bun dev/commands/chromeAuth.ts",
    "store:status": "bun dev/commands/store.ts status",
    "store:submit": "bun dev/commands/store.ts submit",
    "tag-release": "bun dev/commands/release.ts"
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@sentry/browser": "^8.55.2",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "deepmerge": "^4.3.1",
    "motion": "^13.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^9.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@types/bun": "1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "picocolors": "1.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "web-ext": "^8.10.0"
  }
}
